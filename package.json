{
  "name": "virtual-cosmos",
  "version": "1.0.0",
  "description": "Virtual Cosmos realtime proximity chat",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server"
  },
  "keywords": [
    "pixi",
    "socketio",
    "multiplayer",
    "proximity-chat"
  ],
  "author": "",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
